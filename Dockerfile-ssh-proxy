FROM debian:bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive

# OpenSSH 6.6 on the old ubuntu:14.04 base only supported ssh-rsa (SHA-1),
# which modern OpenSSH clients (bookworm, 9.x) refuse. A current base accepts
# the same RSA key via rsa-sha2, so no client/component change is needed.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd \
    && echo 'root:root' | chpasswd \
    && sed -ri 's/^#?PermitRootLogin\s+.*/PermitRootLogin yes/' /etc/ssh/sshd_config

RUN mkdir -p /root/.ssh \
    && echo "ssh-rsa  dev" > /root/.ssh/authorized_keys \
    && chmod 700 /root/.ssh \
    && chmod 600 /root/.ssh/authorized_keys

EXPOSE 22

CMD    ["/usr/sbin/sshd", "-D", "-e"]
