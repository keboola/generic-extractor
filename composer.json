{
    "name": "keboola/ex-generic-v2",
    "description": "Generic HTTP API extractor",
    "license": "MIT",
    "type": "project",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/keboola/juicer.git",
            "no-api": true
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "aws/aws-sdk-php": "^3.208",
        "guzzlehttp/oauth-subscriber": "^0.9",
        "keboola/filter": "^2.0",
        "keboola/juicer": "dev-php-8.5-upgrade as 6.0.0",
        "keboola/php-csvtable": "^2.1",
        "keboola/php-temp": "^2.0",
        "keboola/php-utils": "^4.1",
        "keboola/retry": "^0.5.0",
        "kevinrob/guzzle-cache-middleware": "^3.3",
        "league/flysystem": "~1.0",
        "symfony/config": "^6.4",
        "symfony/console": "^6.4",
        "symfony/finder": "^6.4",
        "symfony/process": "^6.4",
        "symfony/validator": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "keboola/coding-standard": "^16.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": { "Keboola\\GenericExtractor\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Keboola\\GenericExtractor\\Tests\\": "tests/phpunit" }
    },
    "scripts": {
        "tests-phpunit": "phpunit",
        "tests": [
            "@tests-phpunit"
        ],
        "phpstan": "phpstan analyse ./src ./tests --level=max --no-progress -c phpstan.neon",
        "phpcs": "phpcs -n --ignore=vendor --extensions=php .",
        "phpcbf": "phpcbf -n --ignore=vendor --extensions=php .",
        "phplint": "parallel-lint -j 10 --exclude vendor .",
        "build": [
            "@phplint",
            "@phpcs",
            "@phpstan",
            "@tests"
        ],
        "ci": [
            "@composer validate --no-check-publish --no-check-all",
            "@build"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
